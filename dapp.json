{
  "name": "Sheep countrr",
  "icon": {
    "emoji": "\ud83d\udc11"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Bridge script loads with the app shell",
      "path": "/usernode-bridge/v1/bridge.js",
      "expectText": "usernode-bridge.js"
    },
    {
      "id": "round.one",
      "name": "Round 1 shows one still sheep",
      "path": "/?round=1",
      "expectSelector": "#a11y-sheep-list button:nth-child(1)",
      "expectText": "Round 1",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Round 1 explains the objective before counting",
      "id": "round.intro",
      "visual": true,
      "path": "/?round=1",
      "expectSelector": "#round-intro",
      "expectText": "Tap every sheep",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "name": "Round intro shows the Best Round chip",
      "id": "round.intro-best",
      "visual": true,
      "path": "/?scene=intro",
      "expectSelector": "#best-round-chip:not([hidden])",
      "expectText": "Best round",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "id": "round.chaotic",
      "name": "Round 8 board renders a jittery flock",
      "path": "/?round=8",
      "expectSelector": "#a11y-sheep-list button:nth-child(11)",
      "expectText": "Round 8",
      "visual": true,
      "impact": [
        "public/rounds.js",
        "public/movement.js",
        "public/scene.js",
        "public/fallback.js",
        "public/app.js"
      ]
    },
    {
      "name": "Round 1 board draws on a canvas",
      "path": "/?round=1",
      "expectSelector": "canvas.sheep-canvas",
      "expectText": "of 1 sheep"
    },
    {
      "name": "Round 5 counts in with no sheep tapped",
      "path": "/?round=5",
      "expectSelector": "#count-display",
      "expectText": "of 7 sheep"
    },
    {
      "name": "Mid-count keeps the running tap count on screen",
      "path": "/?scene=midcount",
      "expectSelector": "#count-display",
      "expectText": "Round 5"
    },
    {
      "name": "Speed Round intro offers the Speed Round toggle",
      "id": "speed.intro",
      "visual": true,
      "path": "/?scene=intro",
      "expectSelector": "#speed-toggle",
      "expectText": "Speed Round",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/state.js",
        "public/rounds.js",
        "dapp.json"
      ]
    },
    {
      "name": "Speed Round board shows the countdown and the same flock",
      "id": "speed.board",
      "visual": true,
      "path": "/?scene=speed",
      "expectSelector": "#speed-timer:not([hidden])",
      "expectText": "30",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/state.js",
        "public/rounds.js",
        "public/fallback.js",
        "public/scene.js",
        "dapp.json"
      ]
    },
    {
      "name": "Speed Round countdown is accessible in the a11y list",
      "path": "/?scene=speed&renderer=dom",
      "expectSelector": "#a11y-speed-clock",
      "expectText": "Speed Round, 30 seconds left"
    },
    {
      "name": "Speed Round play screen keeps the same count plate",
      "path": "/?round=2&speed=1",
      "expectSelector": "#count-display",
      "expectText": "of 2 sheep"
    },
    {
      "name": "Speed Round game over names the clock",
      "path": "/?scene=speedgameover",
      "expectSelector": "#game-over-reason",
      "expectText": "The clock ran out."
    },
    {
      "name": "Round complete shows the Next round action",
      "path": "/?scene=roundcomplete",
      "expectSelector": "#next-round-btn",
      "expectText": "Next round"
    },
    {
      "name": "Done counting action is on the play screen",
      "path": "/?round=1",
      "expectText": "Done counting"
    },
    {
      "name": "Round complete message names the next flock",
      "path": "/?scene=roundcomplete",
      "expectSelector": "#round-complete-title",
      "expectText": "Round 4 counted."
    },
    {
      "name": "Round complete shows the success message",
      "id": "round.success",
      "visual": true,
      "path": "/?scene=roundcomplete",
      "expectSelector": "#success-title",
      "expectText": "You found all the sheep.",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "name": "Game over shows the round reached and a restart",
      "path": "/?scene=gameover",
      "expectSelector": "#restart-btn",
      "expectText": "You reached round"
    },
    {
      "name": "Game over offers Share result",
      "path": "/?scene=gameover",
      "expectText": "Share result"
    },
    {
      "id": "share.view",
      "name": "Shared result link shows the shared round read-only",
      "path": "/?scene=sharegameover",
      "expectSelector": "#shared-by",
      "expectText": "You reached round 8",
      "visual": true,
      "impact": [
        "public/app.js",
        "public/index.html",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "This week tab marks Speed Round runs",
      "id": "speed.leaderboard",
      "visual": true,
      "path": "/?scene=leaderboard&tab=weekly",
      "expectSelector": "#leaderboard-list",
      "expectText": "Speed 8",
      "impact": [
        "public/app.js",
        "public/rounds.js",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Friends tab offers Invite a friend",
      "path": "/?scene=leaderboard&tab=friends",
      "expectText": "Invite a friend"
    },
    {
      "id": "invite.view",
      "name": "Invite link shows the game and the inviter",
      "path": "/?scene=invite",
      "expectSelector": "#invite-card",
      "expectText": "Sheep countrr",
      "visual": true,
      "impact": [
        "public/app.js",
        "public/index.html",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Share API returns the shared run",
      "path": "/api/share/staging-demo-share",
      "expectText": "Staging demo: Mabel"
    },
    {
      "name": "Invite API names the inviter",
      "path": "/api/invite/demo-invite",
      "expectText": "Staging demo: Mabel"
    },
    {
      "name": "Grown-ups panel shows best round",
      "path": "/?scene=grownups",
      "expectSelector": "#grownups-panel",
      "expectText": "Best round"
    },
    {
      "name": "Grown-ups panel shows the sound effects toggle, on by default in the fixture",
      "path": "/?scene=grownups&sound=1",
      "expectSelector": "#sound-toggle:checked",
      "expectText": "Sound effects"
    },
    {
      "name": "Night Meadow toggle appears in the grown-ups panel",
      "path": "/?scene=grownups",
      "expectSelector": "#night-toggle",
      "expectText": "Night Meadow",
      "allowConsoleErrors": true
    },
    {
      "id": "theme.night-meadow",
      "name": "Night Meadow theme recolors sky and ground",
      "path": "/?scene=grownups&night=1",
      "expectSelector": "body.theme-night #grownups-panel",
      "expectText": "Night Meadow",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/scene.js",
        "public/state.js",
        "dapp.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "No-WebGL fallback renders the same round",
      "path": "/?round=8&renderer=dom",
      "expectSelector": ".sheep-fallback-grid .sheep-card:nth-child(11)",
      "expectText": "Round 8"
    },
    {
      "id": "difficulty.expert",
      "name": "Expert difficulty marks Expert on the briefing card",
      "path": "/?round=1&difficulty=expert",
      "expectSelector": "#difficulty-picker .difficulty-pill[data-difficulty=expert][aria-checked=true]",
      "visual": true,
      "impact": [
        "public/rounds.js",
        "public/state.js",
        "public/app.js",
        "public/index.html",
        "dapp.json"
      ]
    },
    {
      "name": "Largest flock still fits the board",
      "path": "/?scene=flock",
      "expectSelector": "#a11y-sheep-list button:nth-child(12)",
      "expectText": "Round 9"
    },
    {
      "name": "Easy difficulty shrinks the round 5 flock",
      "path": "/?round=5&difficulty=easy",
      "expectSelector": "#count-display",
      "expectText": "of 5 sheep"
    },
    {
      "id": "leaderboard.tabs",
      "name": "Leaderboard card shows the three tabs",
      "path": "/?scene=leaderboard",
      "expectSelector": "#leaderboard-tabs",
      "expectText": "This week",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "dapp.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "id": "leaderboard.weekly",
      "name": "This week tab lists weekly best rounds",
      "path": "/?scene=leaderboard&tab=weekly",
      "expectSelector": "#leaderboard-list",
      "expectText": "Staging demo: Mabel",
      "allowConsoleErrors": true
    },
    {
      "id": "leaderboard.friends",
      "name": "Friends tab shows the add-friend field",
      "path": "/?scene=leaderboard&tab=friends",
      "expectSelector": "#friend-add",
      "expectText": "Add friend",
      "allowConsoleErrors": true
    },
    {
      "id": "round.resume",
      "name": "A saved mid-round board restores on return",
      "path": "/?resume=1&snapshot=%7B%22round%22%3A5%2C%22difficulty%22%3A%22normal%22%2C%22bestRounds%22%3A%7B%22easy%22%3A1%2C%22normal%22%3A5%2C%22hard%22%3A1%2C%22expert%22%3A1%7D%2C%22totalCounted%22%3A3%2C%22soundOn%22%3Afalse%2C%22nightOn%22%3Afalse%2C%22speedOn%22%3Afalse%2C%22midCountdown%22%3A%7B%22round%22%3A5%2C%22difficulty%22%3A%22normal%22%2C%22sheepCount%22%3A7%2C%22seed%22%3A387276923%2C%22counted%22%3A%5B0%2C1%2C2%5D%2C%22countedAt%22%3A%5B%7B%22index%22%3A0%2C%22elapsed%22%3A2.5%7D%2C%7B%22index%22%3A1%2C%22elapsed%22%3A5%7D%2C%7B%22index%22%3A2%2C%22elapsed%22%3A9.5%7D%5D%2C%22roundElapsed%22%3A12%2C%22phase%22%3A%22counting%22%2C%22speedOn%22%3Afalse%2C%22secondsLeft%22%3Anull%7D%7D",
      "expectSelector": "#a11y-sheep-list button:nth-child(4)",
      "expectText": "of 7 sheep",
      "visual": true,
      "impact": [
        "public/state.js",
        "public/app.js",
        "public/scene.js",
        "public/fallback.js",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Resumed board restores on the no-WebGL fallback too",
      "path": "/?resume=1&renderer=dom&snapshot=%7B%22round%22%3A5%2C%22difficulty%22%3A%22normal%22%2C%22bestRounds%22%3A%7B%22easy%22%3A1%2C%22normal%22%3A5%2C%22hard%22%3A1%2C%22expert%22%3A1%7D%2C%22totalCounted%22%3A3%2C%22soundOn%22%3Afalse%2C%22nightOn%22%3Afalse%2C%22speedOn%22%3Afalse%2C%22midCountdown%22%3A%7B%22round%22%3A5%2C%22difficulty%22%3A%22normal%22%2C%22sheepCount%22%3A7%2C%22seed%22%3A387276923%2C%22counted%22%3A%5B0%2C1%2C2%5D%2C%22countedAt%22%3A%5B%7B%22index%22%3A0%2C%22elapsed%22%3A2.5%7D%2C%7B%22index%22%3A1%2C%22elapsed%22%3A5%7D%2C%7B%22index%22%3A2%2C%22elapsed%22%3A9.5%7D%5D%2C%22roundElapsed%22%3A12%2C%22phase%22%3A%22counting%22%2C%22speedOn%22%3Afalse%2C%22secondsLeft%22%3Anull%7D%7D",
      "expectSelector": ".sheep-fallback-grid .sheep-card.is-counted:nth-child(3)",
      "expectText": "of 7 sheep"
    }
  ]
}
