{
  "name": "Sheep countrr",
  "icon": {
    "emoji": "\ud83d\udc11"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Pasture loads for a new child",
      "path": "/?scene=empty",
      "expectSelector": "#count-display",
      "expectText": "0"
    },
    {
      "name": "Mid-count shows three",
      "path": "/?scene=midcount",
      "expectSelector": "#count-display",
      "expectText": "3"
    },
    {
      "name": "Celebration after last sheep",
      "path": "/?scene=celebrate",
      "expectSelector": "#celebration",
      "expectText": "Count again"
    },
    {
      "name": "Grown-ups panel",
      "path": "/?scene=grownups",
      "expectSelector": "#grownups-panel",
      "expectText": "Sound"
    },
    {
      "name": "No-WebGL fallback still counts",
      "path": "/?scene=midcount&renderer=dom",
      "expectSelector": ".sheep-card",
      "expectText": "3"
    },
    {
      "name": "Sleepy sheep portrait",
      "path": "/?scene=portrait",
      "expectSelector": ".sheep-canvas",
      "expectText": "Take your time."
    },
    {
      "name": "Larger wandering flock",
      "path": "/?scene=flock",
      "expectSelector": "#a11y-sheep-list button:nth-child(10)"
    },
    {
      "name": "Quiet bedtime completion",
      "path": "/?scene=celebrate",
      "expectSelector": "#celebration",
      "expectText": "The meadow is resting."
    },
    {
      "name": "Bird-eye meadow",
      "path": "/?scene=birdseye",
      "expectSelector": "canvas[data-camera=\"birdseye\"]",
      "expectText": "Take your time."
    },
    {
      "name": "Ten sheep roam across the meadow",
      "path": "/?scene=roaming",
      "expectSelector": "canvas[data-motion=\"roaming\"]"
    },
    {
      "name": "Reduced-motion meadow holds still",
      "path": "/?scene=still",
      "expectSelector": "canvas[data-motion=\"still\"]"
    }
  ]
}
