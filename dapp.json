{
  "name": "Sheep countrr",
  "icon": { "image": "brand/icon.png", "emoji": "🐑" },
  "secrets": [],
  "tests": [
    {
      "name": "Bridge script loads with the app shell",
      "path": "/usernode-bridge/v1/bridge.js",
      "expectText": "usernode-bridge.js"
    },
    {
      "id": "round.one",
      "name": "Round 1 shows one still sheep",
      "path": "/?round=1",
      "expectSelector": "#a11y-sheep-list button:nth-child(1)",
      "expectText": "Round 1",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Round 1 explains the objective before counting",
      "id": "round.intro",
      "visual": true,
      "path": "/?round=1",
      "expectSelector": "#round-intro",
      "expectText": "Tap every sheep",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "name": "Round intro shows the Best Round chip",
      "id": "round.intro-best",
      "visual": true,
      "path": "/?scene=intro",
      "expectSelector": "#best-round-chip:not([hidden])",
      "expectText": "Best round",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "name": "Round intro shows the day streak flame",
      "id": "round.intro-streak",
      "visual": true,
      "path": "/?scene=intro",
      "expectSelector": "#streak-chip:not([hidden])",
      "expectText": "Day streak",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/state.js",
        "public/rounds.js",
        "dapp.json"
      ]
    },
    {
      "name": "Streak flame reaches the DOM fallback and its a11y card DOM",
      "path": "/?scene=intro&renderer=dom",
      "expectSelector": "#streak-chip:not([hidden])",
      "expectText": "Day streak"
    },
    {
      "id": "round.chaotic",
      "name": "Round 8 board renders a jittery flock",
      "path": "/?round=8",
      "expectSelector": "#a11y-sheep-list button:nth-child(11)",
      "expectText": "Round 8",
      "visual": true,
      "impact": [
        "public/rounds.js",
        "public/movement.js",
        "public/scene.js",
        "public/fallback.js",
        "public/app.js"
      ]
    },
    {
      "name": "Round 1 board draws on a canvas",
      "path": "/?round=1",
      "expectSelector": "canvas.sheep-canvas",
      "expectText": "of 1 sheep"
    },
    {
      "name": "Round badge shows the ladder length",
      "id": "round.progress",
      "visual": true,
      "path": "/?round=5",
      "expectSelector": "#round-badge",
      "expectText": "Round 5 of 9",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/rounds.js",
        "dapp.json"
      ]
    },
    {
      "name": "Round ladder is mirrored in the accessibility layer",
      "path": "/?round=5&renderer=dom",
      "expectSelector": "#a11y-round-progress",
      "expectText": "Round 5 of 9"
    },
    {
      "name": "Round 5 counts in with no sheep tapped",
      "path": "/?round=5",
      "expectSelector": "#count-display",
      "expectText": "of 7 sheep"
    },
    {
      "name": "Mid-count keeps the running tap count on screen",
      "path": "/?scene=midcount",
      "expectSelector": "#count-display",
      "expectText": "Round 5"
    },
    {
      "name": "Speed Round intro offers the Speed Round toggle",
      "id": "speed.intro",
      "visual": true,
      "path": "/?scene=intro",
      "expectSelector": "#speed-toggle",
      "expectText": "Speed Round",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/state.js",
        "public/rounds.js",
        "dapp.json"
      ]
    },
    {
      "name": "Speed Round board shows the countdown and the same flock",
      "id": "speed.board",
      "visual": true,
      "path": "/?scene=speed",
      "expectSelector": "#speed-timer:not([hidden])",
      "expectText": "30",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/state.js",
        "public/rounds.js",
        "public/fallback.js",
        "public/scene.js",
        "dapp.json"
      ]
    },
    {
      "name": "Speed Round countdown is accessible in the a11y list",
      "path": "/?scene=speed&renderer=dom",
      "expectSelector": "#a11y-speed-clock",
      "expectText": "Speed Round, 30 seconds left"
    },
    {
      "name": "Countdown mirrors into the accessible sheep list",
      "path": "/?scene=countdown&renderer=dom",
      "expectSelector": "#a11y-countdown-status",
      "expectText": "Get ready, round starting."
    },
    {
      "id": "round.countdown",
      "name": "Countdown overlay waits before the round starts",
      "path": "/?scene=countdown",
      "expectSelector": "#countdown-overlay:not([hidden]) #countdown-skip-btn",
      "expectText": "3",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "dapp.json"
      ]
    },
    {
      "name": "Speed Round play screen keeps the same count plate",
      "path": "/?round=2&speed=1",
      "expectSelector": "#count-display",
      "expectText": "of 2 sheep"
    },
    {
      "name": "Speed Round game over names the clock",
      "path": "/?scene=speedgameover",
      "expectSelector": "#game-over-reason",
      "expectText": "The clock ran out."
    },
    {
      "name": "Round complete shows the Next round action",
      "path": "/?scene=roundcomplete",
      "expectSelector": "#next-round-btn",
      "expectText": "Next round"
    },
    {
      "name": "Done counting action is on the play screen",
      "path": "/?round=1",
      "expectText": "Done counting"
    },
    {
      "name": "Round complete message names the next flock",
      "path": "/?scene=roundcomplete",
      "expectSelector": "#round-complete-title",
      "expectText": "Round 4 counted."
    },
    {
      "name": "Round complete shows the success message",
      "id": "round.success",
      "visual": true,
      "path": "/?scene=roundcomplete",
      "expectSelector": "#success-title",
      "expectText": "You found all the sheep.",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "name": "Game over shows the round reached and a restart",
      "path": "/?scene=gameover",
      "expectSelector": "#restart-btn",
      "expectText": "You reached round"
    },
    {
      "name": "Game over offers Share result",
      "path": "/?scene=gameover",
      "expectText": "Share result"
    },
    {
      "id": "share.view",
      "name": "Shared result link shows the shared round read-only",
      "path": "/?scene=sharegameover",
      "expectSelector": "#shared-by",
      "expectText": "You reached round 8",
      "visual": true,
      "impact": [
        "public/app.js",
        "public/index.html",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "This week tab marks Speed Round runs",
      "id": "speed.leaderboard",
      "visual": true,
      "path": "/?scene=leaderboard&tab=weekly",
      "expectSelector": "#leaderboard-list",
      "expectText": "Speed 8",
      "impact": [
        "public/app.js",
        "public/rounds.js",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Friends tab offers Invite a friend",
      "path": "/?scene=leaderboard&tab=friends",
      "expectText": "Invite a friend"
    },
    {
      "id": "invite.view",
      "name": "Invite link shows the game and the inviter",
      "path": "/?scene=invite",
      "expectSelector": "#invite-card",
      "expectText": "Sheep countrr",
      "visual": true,
      "impact": [
        "public/app.js",
        "public/index.html",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Share API returns the shared run",
      "path": "/api/share/staging-demo-share",
      "expectText": "Staging demo: Mabel"
    },
    {
      "name": "Invite API names the inviter",
      "path": "/api/invite/demo-invite",
      "expectText": "Staging demo: Mabel"
    },
    {
      "name": "Grown-ups panel shows best round",
      "path": "/?scene=grownups",
      "expectSelector": "#grownups-panel",
      "expectText": "Best round"
    },
    {
      "name": "Grown-ups panel shows the sound effects toggle, on by default in the fixture",
      "path": "/?scene=grownups&sound=1",
      "expectSelector": "#sound-toggle:checked",
      "expectText": "Sound effects"
    },
    {
      "id": "grownups.export",
      "name": "Grown-ups panel offers the CSV export",
      "path": "/?scene=grownups",
      "expectSelector": "#export-btn",
      "expectText": "Export progress (CSV)",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/export.js",
        "dapp.json"
      ]
    },
    {
      "name": "Night Meadow toggle appears in the grown-ups panel",
      "path": "/?scene=grownups",
      "expectSelector": "#night-toggle",
      "expectText": "Night Meadow",
      "allowConsoleErrors": true
    },
    {
      "name": "Calm mode toggle appears in the grown-ups panel",
      "id": "calm.toggle",
      "visual": true,
      "path": "/?scene=grownups&calm=1",
      "expectSelector": "#calm-toggle",
      "expectText": "Calm mode",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/state.js",
        "dapp.json"
      ]
    },
    {
      "name": "Calm mode softens the board and keeps the same flock",
      "id": "calm.board",
      "visual": true,
      "path": "/?round=5&renderer=dom&calm=1",
      "expectSelector": "body.theme-calm .sheep-fallback-grid .sheep-card:nth-child(7)",
      "expectText": "of 7 sheep",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/state.js",
        "public/rounds.js",
        "public/movement.js",
        "public/fallback.js",
        "public/scene.js",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Calm mode a11y list keeps the same sheep slots",
      "path": "/?round=5&renderer=dom&calm=1",
      "expectSelector": "#a11y-sheep-list button:nth-child(7)",
      "expectText": "Sheep 7"
    },
    {
      "id": "theme.night-meadow",
      "name": "Night Meadow theme recolors sky and ground",
      "path": "/?scene=grownups&night=1",
      "expectSelector": "body.theme-night #grownups-panel",
      "expectText": "Night Meadow",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/scene.js",
        "public/state.js",
        "dapp.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "Grown-ups panel shows the Name labels toggle",
      "path": "/?scene=grownups",
      "expectSelector": "#names-toggle",
      "expectText": "Name labels"
    },
    {
      "id": "names.canvas",
      "name": "Name labels float above the canvas flock",
      "path": "/?round=5&names=1",
      "expectSelector": "canvas.sheep-canvas",
      "expectText": "is grazing",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/scene.js",
        "public/layout.js",
        "public/state.js",
        "dapp.json"
      ]
    },
    {
      "id": "names.dom",
      "name": "Name labels appear on the DOM fallback cards",
      "path": "/?round=5&renderer=dom&names=1",
      "expectSelector": ".sheep-name-label:not([hidden])",
      "expectText": "is grazing",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/fallback.js",
        "public/layout.js",
        "public/state.js",
        "dapp.json"
      ]
    },
    {
      "name": "No-WebGL fallback renders the same round",
      "path": "/?round=8&renderer=dom",
      "expectSelector": ".sheep-fallback-grid .sheep-card:nth-child(11)",
      "expectText": "Round 8"
    },
    {
      "id": "difficulty.expert",
      "name": "Expert difficulty marks Expert on the briefing card",
      "path": "/?round=1&difficulty=expert",
      "expectSelector": "#difficulty-picker .difficulty-pill[data-difficulty=expert][aria-checked=true]",
      "visual": true,
      "impact": [
        "public/rounds.js",
        "public/state.js",
        "public/app.js",
        "public/index.html",
        "dapp.json"
      ]
    },
    {
      "name": "Largest flock still fits the board",
      "path": "/?scene=flock",
      "expectSelector": "#a11y-sheep-list button:nth-child(12)",
      "expectText": "Round 9"
    },
    {
      "id": "wolf.round",
      "name": "The wolf round renders a five-sheep flock with the wolf hiding",
      "path": "/?scene=wolfround",
      "expectSelector": "#a11y-sheep-list button:nth-child(5)",
      "expectText": "Round 5",
      "visual": true,
      "impact": [
        "public/rounds.js",
        "public/state.js",
        "public/scene.js",
        "public/fallback.js",
        "public/app.js",
        "dapp.json"
      ]
    },
    {
      "name": "Easy difficulty shrinks the round 5 flock",
      "path": "/?round=5&difficulty=easy",
      "expectSelector": "#count-display",
      "expectText": "of 5 sheep"
    },
    {
      "id": "leaderboard.tabs",
      "name": "Leaderboard card shows the three tabs",
      "path": "/?scene=leaderboard",
      "expectSelector": "#leaderboard-tabs",
      "expectText": "This week",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "dapp.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "id": "leaderboard.weekly",
      "name": "This week tab lists weekly best rounds",
      "path": "/?scene=leaderboard&tab=weekly",
      "expectSelector": "#leaderboard-list",
      "expectText": "Staging demo: Mabel",
      "allowConsoleErrors": true
    },
    {
      "id": "leaderboard.friends",
      "name": "Friends tab shows the add-friend field",
      "path": "/?scene=leaderboard&tab=friends",
      "expectSelector": "#friend-add",
      "expectText": "Add friend",
      "allowConsoleErrors": true
    },
    {
      "id": "duel.handoff",
      "name": "Pass-and-play Duel shows the pass-the-device card",
      "path": "/?scene=duelhandoff",
      "expectSelector": "#duel-panel",
      "expectText": "Pass the device",
      "visual": true,
      "impact": [
        "public/app.js",
        "public/index.html",
        "public/state.js",
        "tests/game.test.mjs",
        "dapp.json"
      ]
    },
    {
      "name": "Wolf game over names the trick",
      "id": "wolf.gameover",
      "path": "/?scene=wolfgameover",
      "expectSelector": "#game-over-reason",
      "expectText": "The wolf tricked you."
    },
    {
      "name": "Wolf fallback card shows the disguise cues",
      "id": "wolf.fallback",
      "path": "/?scene=wolfround&renderer=dom",
      "expectSelector": ".sheep-fallback-grid .sheep-card:nth-child(5)",
      "expectText": "Round 5"
    },
    {
      "name": "Grown-ups panel shows the wolf record",
      "id": "wolf.stats",
      "path": "/?scene=grownups",
      "expectSelector": "#grownups-panel",
      "expectText": "Best safe streak"
    },
    {
      "id": "duel.result",
      "name": "Pass-and-play Duel shows both miss counts and the winner",
      "path": "/?scene=duelresult",
      "expectSelector": "#duel-panel-scores",
      "expectText": "Sheep counter 1 wins",
      "visual": true,
      "impact": [
        "public/app.js",
        "public/index.html",
        "dapp.json"
      ]
    },
    {
      "name": "The duel result card offers a way back to the player's own game",
      "path": "/?scene=duelresult",
      "expectSelector": "#duel-panel-exit:not([hidden])",
      "expectText": "Back to my game"
    },
    {
      "id": "round.resume",
      "name": "A saved mid-round board restores on return",
      "path": "/?resume=1&snapshot=%7B%22midCountdown%22%3A%7B%22round%22%3A5%2C%22seed%22%3A387276923%2C%22counted%22%3A%5B0%2C1%2C2%5D%2C%22phase%22%3A%22counting%22%7D%7D",
      "expectSelector": "#a11y-sheep-list button:nth-child(3)",
      "expectText": "Sheep 3, counted",
      "visual": true,
      "impact": [
        "public/state.js",
        "public/app.js",
        "public/scene.js",
        "public/fallback.js",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Duel turn clock shows on a live duel board",
      "path": "/?round=1&duel=1",
      "expectSelector": "#duel-turn-clock:not([hidden])",
      "expectText": "Pass and play"
    },
    {
      "name": "Duel toggle appears on the briefing card",
      "path": "/?scene=intro",
      "expectSelector": "#duel-toggle",
      "expectText": "Pass-and-play Duel"
    },
    {
      "name": "Duel board renders the DOM fallback with the shared flock",
      "path": "/?round=2&duel=1&renderer=dom",
      "expectSelector": ".sheep-fallback-grid .sheep-card:nth-child(2)"
    },
    {
      "name": "Resumed board restores on the no-WebGL fallback too",
      "path": "/?resume=1&renderer=dom&snapshot=%7B%22midCountdown%22%3A%7B%22round%22%3A5%2C%22seed%22%3A387276923%2C%22counted%22%3A%5B0%2C1%2C2%5D%2C%22phase%22%3A%22counting%22%7D%7D",
      "expectSelector": ".sheep-fallback-grid .sheep-card.is-counted:nth-child(3)",
      "expectText": "Sheep 3, counted"
    }
  ]
}
