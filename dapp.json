{
  "name": "Sheep countrr",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🐑"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Bridge script loads with the app shell",
      "path": "/usernode-bridge/v1/bridge.js",
      "expectText": "usernode-bridge.js"
    },
    {
      "id": "round.one",
      "name": "Level 1 shows one still sheep",
      "path": "/?round=1",
      "expectSelector": "#a11y-sheep-list button:nth-child(1)",
      "expectText": "Level 1",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "id": "boot.ready",
      "name": "App finishes booting and clears the boot card",
      "path": "/?round=1",
      "expectSelector": "html[data-booted] #round-badge",
      "expectText": "Level 1",
      "impact": [
        "public/index.html",
        "public/app.js",
        "dapp.json"
      ]
    },
    {
      "id": "round.open",
      "name": "The app opens straight onto the meadow with no Get ready card",
      "visual": true,
      "path": "/?round=1",
      "expectSelector": "body:not(:has(#round-intro)) #play-hint",
      "expectText": "Tap the sheep to start",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "id": "round.chaotic",
      "name": "Level 10 board renders a jittery flock of eleven",
      "path": "/?round=29",
      "expectSelector": "#a11y-sheep-list button:nth-child(11)",
      "expectText": "Level 10",
      "visual": true,
      "impact": [
        "public/rounds.js",
        "public/movement.js",
        "public/scene.js",
        "public/fallback.js",
        "public/app.js"
      ]
    },
    {
      "name": "Round 1 board draws on a canvas",
      "path": "/?round=1",
      "expectSelector": "canvas.sheep-canvas",
      "expectText": "of 1 sheep"
    },
    {
      "name": "Corner tag names the level",
      "id": "round.progress",
      "visual": true,
      "path": "/?round=5",
      "expectSelector": "#round-badge",
      "expectText": "Level 2",
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/rounds.js",
        "dapp.json"
      ]
    },
    {
      "name": "Level and round are mirrored in the accessibility layer",
      "path": "/?round=5&renderer=dom",
      "expectSelector": "#a11y-round-progress",
      "expectText": "Level 2, round 2 of 3"
    },
    {
      "name": "Round 5 counts in with no sheep tapped",
      "path": "/?round=5",
      "expectSelector": "#count-display",
      "expectText": "of 3 sheep"
    },
    {
      "name": "Mid-count keeps the running tap count on screen",
      "path": "/?scene=midcount",
      "expectSelector": "#count-display",
      "expectText": "Level 6"
    },
    {
      "name": "Mid-count fills the first three progress dots and counts down",
      "id": "count.dots",
      "path": "/?scene=midcount",
      "expectSelector": "#count-dots .count-dot.is-filled:nth-child(3)",
      "expectText": "4 left!",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "public/rounds.js",
        "dapp.json"
      ]
    },
    {
      "id": "clock.board",
      "name": "A level 3 round shows its clock",
      "path": "/?round=7",
      "expectSelector": "#speed-timer:not([hidden])",
      "impact": [
        "public/rounds.js",
        "public/state.js",
        "public/app.js",
        "public/index.html",
        "dapp.json"
      ]
    },
    {
      "name": "The round clock is mirrored in the accessible sheep list",
      "path": "/?round=7&renderer=dom",
      "expectSelector": "#a11y-speed-clock",
      "expectText": "seconds left"
    },
    {
      "name": "Levels 1 and 2 have no clock",
      "path": "/?round=4",
      "expectSelector": "#speed-timer[hidden]"
    },
    {
      "name": "Running out of clock ends the run with its own line",
      "path": "/?scene=timeupgameover",
      "expectSelector": "#game-over-reason",
      "expectText": "The clock ran out."
    },
    {
      "name": "Solo play has no Done counting button",
      "id": "done.solo-hidden",
      "path": "/?round=1",
      "expectSelector": "#submit-count[hidden]"
    },
    {
      "name": "A duel turn keeps its Done counting hand-in",
      "path": "/?round=1&duel=1",
      "expectSelector": "#submit-count:not([hidden])",
      "expectText": "Done counting"
    },
    {
      "id": "flow.pass",
      "name": "A counted round shows the short count in the meadow, not a card",
      "visual": true,
      "path": "/?scene=roundpass",
      "expectSelector": "#flow-banner:not([hidden]) #flow-banner-line",
      "expectText": "You counted 4 sheep.",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "name": "A plain round pass has no level-up title",
      "path": "/?scene=roundpass",
      "expectSelector": "#flow-banner #flow-banner-title[hidden]"
    },
    {
      "id": "flow.levelup",
      "name": "Every third round plays the level-up moment",
      "visual": true,
      "path": "/?scene=levelup",
      "expectSelector": "#flow-banner:not([hidden]) #flow-banner-title:not([hidden])",
      "expectText": "Level 3!",
      "impact": [
        "public/**",
        "dapp.json"
      ]
    },
    {
      "name": "The pass banner is announced politely and never blocks a tap",
      "path": "/?scene=levelup",
      "expectSelector": "#flow-banner.pointer-events-none[aria-live='polite']"
    },
    {
      "name": "Counting the last sheep shows the short count on a real run",
      "path": "/?round=1&autoplay=1&renderer=dom",
      "expectSelector": "#flow-banner:not([hidden]) #flow-banner-line",
      "expectText": "You counted 1 sheep."
    },
    {
      "name": "The next flock walks in by itself after a round",
      "path": "/?round=1&autoplay=next&renderer=dom",
      "expectSelector": ".sheep-fallback-grid .sheep-card:nth-child(2)",
      "expectText": "Level 1"
    },
    {
      "name": "Passing a level's last round plays the level-up on a real run",
      "path": "/?round=9&autoplay=1&renderer=dom",
      "expectSelector": "#flow-banner-title:not([hidden])",
      "expectText": "Level 4!"
    },
    {
      "name": "There is no last round: round 9 leads into level 4",
      "path": "/?round=9&autoplay=next&renderer=dom",
      "expectSelector": "#round-badge",
      "expectText": "Level 4"
    },
    {
      "name": "Game over shows the level reached and a restart",
      "path": "/?scene=gameover",
      "expectSelector": "#restart-btn",
      "expectText": "You reached level"
    },
